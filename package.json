{
    "name": "opensauce-pos",
    "version": "1.6.7",
    "main": "dist/main.cjs",
    "homepage": "./",
    "client/index.html": "client/index.html",
    "author": "OpenSauce",
    "type": "module",
    "license": "MIT",
    "build": {
        "appId": "com.opensauce.pos",
        "productName": "OpenSauce POS",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "assets/**/*",
            "migrations/**/*",
            "app-update.yml",
            "package.json"
        ],
        "win": {
            "icon": "assets/icon.ico",
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "category": "public.app-category.business",
            "icon": "assets/icon.icns",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "assets/entitlements.mac.plist",
            "entitlementsInherit": "assets/entitlements.mac.plist"
        },
        "linux": {
            "icon": "assets/icons",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Office",
            "desktop": {}
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "OpenSauce POS",
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "warningsAsErrors": false
        },
        "extraFiles": [
            {
                "from": "sqlite.db",
                "to": "database/sqlite.db"
            }
        ],
        "asar": true,
        "publish": {
            "provider": "github",
            "owner": "your-github-username",
            "repo": "opensauce-pos"
        }
    },
    "dependencies": {
        "@babel/types": "^7.28.5",
        "@capacitor-community/bluetooth-le": "^7.2.0",
        "@capacitor/android": "^7.4.4",
        "@capacitor/app": "^7.1.0",
        "@capacitor/cli": "^7.4.4",
        "@capacitor/core": "^7.4.4",
        "@capacitor/haptics": "^7.0.2",
        "@capacitor/ios": "^7.4.4",
        "@capacitor/network": "^7.0.2",
        "@capacitor/preferences": "^7.0.2",
        "@capacitor/share": "^7.0.2",
        "@capacitor/splash-screen": "^7.0.3",
        "@capacitor/status-bar": "^7.0.3",
        "@hookform/resolvers": "^3.9.1",
        "@jridgewell/trace-mapping": "^0.3.25",
        "@radix-ui/react-accordion": "^1.2.1",
        "@radix-ui/react-alert-dialog": "^1.1.2",
        "@radix-ui/react-aspect-ratio": "^1.1.0",
        "@radix-ui/react-avatar": "^1.1.1",
        "@radix-ui/react-checkbox": "^1.1.2",
        "@radix-ui/react-collapsible": "^1.1.1",
        "@radix-ui/react-context-menu": "^2.2.2",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-dropdown-menu": "^2.1.2",
        "@radix-ui/react-hover-card": "^1.1.2",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-menubar": "^1.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.1",
        "@radix-ui/react-popover": "^1.1.2",
        "@radix-ui/react-progress": "^1.1.0",
        "@radix-ui/react-radio-group": "^1.2.1",
        "@radix-ui/react-scroll-area": "^1.2.0",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slider": "^1.2.1",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.1",
        "@radix-ui/react-tabs": "^1.1.1",
        "@radix-ui/react-toast": "^1.2.2",
        "@radix-ui/react-toggle": "^1.1.0",
        "@radix-ui/react-toggle-group": "^1.1.0",
        "@radix-ui/react-tooltip": "^1.1.3",
        "@replit/vite-plugin-shadcn-theme-json": "^0.0.4",
        "@serialport/parser-readline": "^13.0.0",
        "@tanstack/react-query": "^5.60.5",
        "@types/better-sqlite3": "^7.6.13",
        "@zxing/library": "^0.21.3",
        "better-sqlite3": "^12.6.0",
        "bufferutil": "^4.0.8",
        "caniuse-lite": "^1.0.30001763",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.0.0",
        "date-fns": "^3.6.0",
        "drizzle-orm": "^0.45.1",
        "drizzle-zod": "^0.8.3",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.7.3",
        "embla-carousel-react": "^8.3.0",
        "escpos": "^3.0.0-alpha.6",
        "escpos-network": "^3.0.0-alpha.5",
        "escpos-usb": "^3.0.0-alpha.4",
        "framer-motion": "^11.13.1",
        "google-translate-api-x": "^10.7.2",
        "idb": "^8.0.2",
        "input-otp": "^1.2.4",
        "jspdf": "^3.0.4",
        "lucide-react": "^0.362.0",
        "papaparse": "^5.5.3",
        "puppeteer": "^23.6.0",
        "python": "^0.0.4",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "qrcode.react": "^4.2.0",
        "rate-limiter-flexible": "^5.0.3",
        "react": "^18.3.1",
        "react-barcode": "^1.6.1",
        "react-day-picker": "^8.10.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.53.1",
        "react-icons": "^5.4.0",
        "react-resizable-panels": "^2.1.4",
        "recharts": "^2.13.0",
        "rxjs": "^7.8.2",
        "serialport": "^13.0.0",
        "socket.io-client": "^4.8.1",
        "tailwind-merge": "^2.5.4",
        "tailwindcss-animate": "^1.0.7",
        "uuid": "^13.0.0",
        "vaul": "^1.1.0",
        "whatsapp-web.js": "^1.23.0",
        "wouter": "^3.3.5",
        "zod": "^4.0.0",
        "zod-validation-error": "^4.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@electron/rebuild": "^4.0.2",
        "@playwright/test": "^1.57.0",
        "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
        "@tailwindcss/typography": "^0.5.15",
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^20.19.27",
        "@types/qrcode": "^1.5.6",
        "@types/qrcode-terminal": "^0.12.2",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@types/serialport": "^8.0.5",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^4.3.2",
        "autoprefixer": "^10.4.20",
        "bcrypt": "^5.1.1",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.8",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "electron-rebuild": "^3.2.9",
        "esbuild": "^0.27.0",
        "lightningcss": "^1.30.2",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.47",
        "rollup-plugin-visualizer": "^6.0.5",
        "tailwindcss": "^3.4.14",
        "terser": "^5.44.1",
        "tsx": "^4.19.1",
        "typescript": "5.6.3",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.1.0",
        "wait-on": "^9.0.3"
    },
    "scripts": {
        "postinstall": "electron-builder install-app-deps && npx @electron/rebuild -f -w better-sqlite3",
        "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" npx vite --host --port 5173 --strictPort",
        "dev:electron": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node electron/start-dev-optimized.cjs",
        "electron:debug": "cross-env NODE_ENV=development NODE_OPTIONS=\"--max-old-space-size=4096\" electron dist/main.mjs --remote-debugging-port=9222 --enable-logging --user-data-dir=./.dev-data",
        "rebuild:db": "npx @electron/rebuild -f -w better-sqlite3",
        "launch:debug": "npm run build:parallel && npm run electron:debug",
        "start:server": "tsx server/index.ts",
        "build": "npm run build:parallel && npm run generate:database",
        "build:parallel": "npm-run-all --parallel build:electron:main build:electron:client",
        "build:electron:client": "cross-env VITE_ELECTRON=true NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
        "build:mobile": "vite build",
        "build:electron:main": "esbuild electron/main.ts --platform=node --format=cjs --bundle --outfile=dist/main.cjs --external:electron --external:electron-log --external:better-sqlite3 --external:drizzle-orm/better-sqlite3 --external:drizzle-orm/better-sqlite3/migrator --external:fs --external:path --external:os --external:escpos --external:escpos-usb --external:escpos-network --external:usb --external:rate-limiter-flexible --external:zod --external:diagnostics_channel && esbuild electron/preload.ts --platform=node --format=cjs --bundle --outfile=dist/preload.cjs --external:electron --external:electron-log --external:zod --external:rate-limiter-flexible",
        "build:electron:optimized": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx electron init-db.cjs && npm run build:parallel && npx electron-builder --win --dir -c.compression=store",
        "build:electron:installer": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx electron init-db.cjs && npm run build:parallel && npx electron-builder --win -c.compression=normal",
        "build:electron:mac": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx electron init-db.cjs && npm run build:parallel && npx electron-builder --mac",
        "build:electron:linux": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx electron init-db.cjs && npm run build:parallel && npx electron-builder --linux",
        "build:electron:all": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx electron init-db.cjs && npm run build:parallel && npx electron-builder -mwl",
        "build:safe": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npm run build",
        "build:server": "esbuild server/index.ts --platform=node --format=esm --bundle --outfile=dist/index.js --external:express --external:fs --external:path --external:url --external:net --external:child_process --external:sqlite3 --external:@types/better-sqlite3 --external:better-sqlite3 --external:drizzle-orm --external:drizzle-zod --external:zod --external:socket.io",
        "start": "cross-env NODE_ENV=production node dist/main.mjs",
        "check": "tsc",
        "cap:sync": "npm run build:mobile && npx cap sync",
        "cap:android": "npm run cap:sync && npx cap open android",
        "cap:ios": "npm run cap:sync && npx cap open ios",
        "cap:run:android": "npm run cap:sync && npx cap run android",
        "cap:run:ios": "npm run cap:sync && npx cap run ios",
        "whatsapp-start": "node dist/whatsapp.js",
        "build:web": "vite build",
        "generate:assets": "node scripts/generate-assets.js",
        "generate:database": "electron scripts/generate-database.js --web",
        "test": "playwright test",
        "test:whatsapp": "playwright test tests/lib/capacitor-whatsapp.test.ts tests/services/whatsapp-service.test.ts tests/bot/whatsapp-bot.test.ts tests/integration/whatsapp-flow.test.ts",
        "test:lib": "playwright test tests/lib/",
        "test:service": "playwright test tests/services/",
        "test:bot": "playwright test tests/bot/",
        "test:integration": "playwright test tests/integration/"
    }
}
