{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "outDir": "../dist",
        "rootDir": "..",
        "types": [
            "node",
            "better-sqlite3"
        ]
    },
    "include": [
        "*.ts",
        "*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}